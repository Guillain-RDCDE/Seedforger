<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 (no -windows): runs on Windows, Linux and macOS. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Seedforger.ConsoleHost</RootNamespace>
    <AssemblyName>Seedforger.Cli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <Import Project="..\Publish.props" />

  <!-- After the import, so it can react to PublishTrimmed being set there.
       No UI here, so the trimmer can be aggressive. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seedforger.Core\Seedforger.Core.csproj" />
  </ItemGroup>

</Project>
