<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Seedforger.App.ViewModels"
        x:Class="Seedforger.App.Views.MainWindow"
        x:CompileBindings="False"
        Title="Seedforger" Width="880" Height="640"
        MinWidth="780" MinHeight="560"
        FontSize="13" FontFamily="Segoe UI, Inter, sans-serif">

  <!-- A classic desktop layout: menu bar, labelled groups with standard controls
       in the theme's own colours, a log, and a status bar. No custom palette. -->

  <Window.Styles>
    <Style Selector="Border.group">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- ===== menu bar ===== -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{Binding L[menu.file]}">
        <MenuItem Header="{Binding L[menu.load_torrent]}" Click="OnBrowse" />
        <Separator />
        <MenuItem Header="{Binding L[menu.exit]}" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="{Binding L[menu.run]}">
        <MenuItem Header="{Binding L[start_seeding]}" Command="{Binding StartCommand}" />
        <MenuItem Header="{Binding L[stop]}" Command="{Binding StopCommand}" />
        <Separator />
        <MenuItem Header="{Binding L[menu.test_announce]}" Click="OnTestAnnounce" />
        <MenuItem Header="{Binding L[menu.serve_real]}" Click="OnServeReal" />
      </MenuItem>
      <MenuItem Header="{Binding L[menu.tools]}">
        <MenuItem Header="{Binding L[menu.guided]}" Click="OnGuided" />
        <MenuItem Header="{Binding L[menu.campaigns]}" Click="OnCampaigns" />
        <Separator />
        <MenuItem Header="{Binding L[menu.advanced_settings]}" Click="OnAdvanced" />
      </MenuItem>
      <MenuItem Header="{Binding L[menu.settings]}">
        <MenuItem Header="{Binding L[menu.realistic]}" ToggleType="CheckBox" IsChecked="{Binding Realistic, Mode=TwoWay}" />
        <MenuItem Header="{Binding L[menu.swarm]}" ToggleType="CheckBox" IsChecked="{Binding SwarmAware, Mode=TwoWay}" />
        <MenuItem Header="{Binding L[menu.randomize]}" ToggleType="CheckBox" IsChecked="{Binding RandomizeClient, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="{Binding L[menu.language]}">
          <MenuItem Header="English" ToggleType="CheckBox" IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
          <MenuItem Header="Français" ToggleType="CheckBox" IsChecked="{Binding IsFrench, Mode=TwoWay}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{Binding L[menu.help]}">
        <MenuItem Header="{Binding L[menu.about]}" Click="OnAbout" />
        <MenuItem Header="{Binding L[menu.open_repo]}" Click="OnRepo" />
      </MenuItem>
    </Menu>

    <!-- ===== status bar ===== -->
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="12,5"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <Grid ColumnDefinitions="Auto,24,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
        <TextBlock Grid.Column="2" Text="{Binding ClientSummary}" />
        <TextBlock Grid.Column="3" Text="{Binding VersionText}" />
      </Grid>
    </Border>

    <!-- ===== content ===== -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="12,10,12,10">

      <Grid Grid.Row="0" ColumnDefinitions="3*,12,2*">

        <!-- Torrent -->
        <Border Grid.Column="0" Classes="group">
          <StackPanel Spacing="8">
            <TextBlock Classes="groupTitle" Text="{Binding L[grp.torrent]}" />

            <Grid ColumnDefinitions="130,*,8,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding L[lbl.file]}" />
              <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding TorrentDisplay}"
                       ToolTip.Tip="{Binding L[tip.drop]}" />
              <Button Grid.Column="3" MinWidth="100" Content="{Binding L[browse]}" Click="OnBrowse" />
            </Grid>

            <Grid ColumnDefinitions="130,3*,8,Auto,8,2*,8,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding L[lbl.client]}" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding L[tip.client]}"
                        ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}" />
              <TextBlock Grid.Column="3" Classes="label" Text="{Binding L[lbl.version]}" />
              <ComboBox Grid.Column="5" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" />
              <Button Grid.Column="7" MinWidth="100" Content="{Binding L[advanced]}" Click="OnAdvanced"
                      ToolTip.Tip="{Binding L[tip.advanced]}" />
            </Grid>

            <Grid ColumnDefinitions="130,*">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding L[lbl.mode]}" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Modes}" SelectedIndex="{Binding SelectedModeIndex}" />
            </Grid>

            <Grid ColumnDefinitions="130,140,*">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding L[lbl.upload]}" />
              <TextBox Grid.Column="1" Text="{Binding UploadText}" ToolTip.Tip="{Binding L[tip.upload]}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Column="2" Classes="group">
          <StackPanel>
            <TextBlock Classes="groupTitle" Text="{Binding L[grp.status]}" />
            <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{Binding L[lbl.ratio]}" ToolTip.Tip="{Binding L[tip.ratio]}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RatioText}" FontSize="22" FontWeight="Bold"
                         Margin="0,0,0,4" ToolTip.Tip="{Binding L[tip.ratio]}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{Binding L[lbl.uploaded]}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="value" Text="{Binding UploadedText}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{Binding L[lbl.downloaded]}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="value" Text="{Binding DownloadedText}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{Binding L[lbl.swarm]}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Classes="value" Text="{Binding SwarmText}" />
              <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="{Binding L[lbl.elapsed]}" />
              <TextBlock Grid.Row="4" Grid.Column="2" Classes="value" Text="{Binding ElapsedText}" />
              <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="{Binding L[lbl.state]}" />
              <TextBlock Grid.Row="5" Grid.Column="2" Classes="value" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- action buttons -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,12">
        <Button Classes="accent" MinWidth="150" Padding="14,7" Content="{Binding L[start_seeding]}"
                Command="{Binding StartCommand}" />
        <Button MinWidth="110" Padding="14,7" Content="{Binding L[stop]}" Command="{Binding StopCommand}" />
        <Button MinWidth="140" Padding="14,7" Margin="12,0,0,0" Content="{Binding L[btn.test]}" Click="OnTestAnnounce"
                ToolTip.Tip="{Binding L[menu.test_announce]}" />
      </StackPanel>

      <!-- log -->
      <Border Grid.Row="2" Classes="group">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="{Binding L[grp.log]}" />
          <ScrollViewer Name="LogScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock Text="{Binding ActivityText}" TextWrapping="Wrap"
                                 FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
