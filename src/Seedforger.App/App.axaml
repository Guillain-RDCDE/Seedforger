<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Seedforger.App.App"
             RequestedThemeVariant="Light">
  <!-- The stock Fluent theme, light variant: standard controls in standard colours. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
